  "dialogues": [
    {
      "dialogue_id": "littleroot.player_house.mom.welcome.001",
      "variants": [
        {
          "id": "simple",
          "text": "Hallo!",
          "english_gloss": "Hello!",
          "cefr": "A1",
          "internal_difficulty": 5,
