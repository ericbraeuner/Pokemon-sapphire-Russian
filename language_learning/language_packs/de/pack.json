          }
        },
        {
          "id": "expanded",
          "text": "Hallo! Willkommen zu Hause!",
          "english_gloss": "Hello! Welcome home!",
          "cefr": "A1",
          "internal_difficulty": 11,
          "vocabulary_ids": [
            "de.hallo",
            "de.willkommen",
            "de.zuhause",
            "de.haus"
          ],
          "grammar_note_ids": [],
