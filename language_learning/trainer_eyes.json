  "TrainerEyeDescription_Tuber_Ricky": ["Не знаю. Постараюсь.", "Водные - мои друзья.", "Я умею плавать.", "Люблю свой круг."],
  "TrainerEyeDescription_SisAndBro_RitaAndSam": ["Делим обязанности.", "Любим дружелюбных.", "Растим их вместе,", "как брат и сестра."],
  "TrainerEyeDescription_Cooltrainer_Brooke": ["Бью в слабые места.", "Важен баланс.", "Моя цель - стать", "ЧЕМПИОНОМ ПОКЕМОНОВ."],
  "TrainerEyeDescription_Cooltrainer_Wilton": ["Сбиваю соперника.", "Тип не важен.", "Я лучший ученик", "ШКОЛЫ ТРЕНЕРОВ."],
  "TrainerEyeDescription_HexManiac_Valerie": ["Мучаю медленно.", "Страшна по ночам.", "Я вижу то, чего", "не видят другие..."],
  "TrainerEyeDescription_Lady_Cindy": ["Всё ради победы.", "Роскошный тип!", "Дома есть бассейн", "только для ПОКЕМОНОВ."],
  "TrainerEyeDescription_Beauty_Jessica": ["Заведу тебя не туда.", "Конечно, милые.", "Обожаю ЗОНУ САФАРИ.", "Всегда туда попадаю."],
  "TrainerEyeDescription_RichBoy_Winston": ["Зачем мне стратегия?", "Я дорого заплатил!", "Я богат и сплю", "в кровати ПОКЕМОНОВ."],
  "TrainerEyeDescription_PokeManiac_Steve": ["Одолею мощью.", "Ловил всю ночь...", "Большие и сильные", "ПОКЕМОНЫ лучше..."],
  "TrainerEyeDescription_Swimmer_Tony": ["Мчусь во весь дух!", "Классный водный тип!", "Когда не плаваю,", "качаю мышцы."],
  "TrainerEyeDescription_BlackBelt_Nob": ["Мощный град ударов!", "Боевой тип.", "Без хвастовства: я", "разобью десять плит!"],
  "TrainerEyeDescription_Guitarist_Dalton": ["Ударю током!", "Они электрические!", "Хочу тронуть людей", "песней от сердца."],
  "TrainerEyeDescription_Kindler_Bernie": ["Сожгу всё дотла!", "Обжигающие ПОКЕМОНЫ.", "Разводя костёр,", "держи воду рядом."],
  "TrainerEyeDescription_Camper_Ethan": ["Стою до конца!", "Выращу любого.", "Дикие ПОКЕМОНЫ", "становятся сильными!"],
  "TrainerEyeDescription_OldCouple_JohnAndJay": ["Любовь ведёт нас.", "Они с нами много лет.", "Мы женаты 50 лет", "и преданно их растим."],
  "TrainerEyeDescription_BugManiac_Brandon": ["Атакую волнами!", "Насекомые круты.", "Каждый день я в лесу", "ловить насекомых."],
  "TrainerEyeDescription_Psychic_Cameron": ["Оглушу и запутаю!", "Со странными силами.", "Я точно вижу,", "о чём ты думаешь!"],
  "TrainerEyeDescription_Psychic_Jacki": ["Бьюсь в полную силу.", "Полны загадок.", "Когда мы говорили,", "я читал твои мысли."],
  "TrainerEyeDescription_Gentleman_Walter": ["Спокоен и собран.", "Изысканные ПОКЕМОНЫ.", "Пьём чай ежедневно.", "Он привезён издалека."],
  "TrainerEyeDescription_SchoolKid_Karen": ["Думаю в бою.", "Люблю всех ПОКЕМОНОВ!", "Папа даёт мне деньги", "за отличные оценки."],
  "TrainerEyeDescription_SchoolKid_Jerry": ["Знания правят!", "Любой умный ПОКЕМОН!", "Хочу в будущем стать", "исследователем." ]
