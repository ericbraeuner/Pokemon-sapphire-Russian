  "TrainerEyeDescription_Triathlete_Katelyn": ["Только наступление!", "Водные лучше всех!", "Я должна проплывать", "больше 10 км в день."],
  "TrainerEyeDescription_Triathlete_Maria": ["Скорость важнее!", "Быстрый ПОКЕМОН.", "Марафон - это вызов", "самому себе."],
  "TrainerEyeDescription_Triathlete_Dylan": ["Бью первым!", "Быстро бегающий.", "Беги без остановки", "и станешь ветром."],
  "TrainerEyeDescription_DragonTamer_Nicolas": ["Важна сила ПОКЕМОНОВ!", "Узри силу ДРАКОНОВ!", "Однажды я стану", "сильнейшей легендой!"],
  "TrainerEyeDescription_BirdKeeper_Robert": ["Покажу свою технику!", "Изящные птицы.", "Мой ПОКЕМОН-ПТИЦА,", "передай ей любовь!"],
  "TrainerEyeDescription_NinjaBoy_Lao": ["Тебя отравит яд!", "Ядовитые ПОКЕМОНЫ.", "Я усердно учусь,", "чтобы стать ниндзя."],
  "TrainerEyeDescription_BattleGirl_Cyndy": ["Первый удар решает!", "Быстрый боевой тип.", "Если ПОКЕМОН падёт,", "я продолжу бой!"],
  "TrainerEyeDescription_ParasolLady_Madeline": ["Вперёд, мой ПОКЕМОН!", "Выращу любого.", "УФ-лучи вредят коже.", "Защищайся от них."],
  "TrainerEyeDescription_Swimmer_Jenny": ["Без пощады!", "Милые водные.", "У меня много фанатов.", "Меня показали по ТВ."],
  "TrainerEyeDescription_Picnicker_Diana": ["Думаю обо всём.", "Люблю всех ПОКЕМОНОВ.", "Что же находится", "за дальним холмом?"],
  "TrainerEyeDescription_Twins_AmyAndLiv": ["Сражаемся вместе!", "Тренируемся вместе!", "Любим тех же самых,", "но разные десерты."],
